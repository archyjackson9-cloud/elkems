# Environment variables for docker-compose.yml (Hostinger Docker Manager -> Environment)
APP_PORT=80
APP_NAME="ELD Solutions Ltd"
# Generate with: php artisan key:generate --show
APP_KEY=
APP_URL=https://yourdomain.com

DB_DATABASE=eldsolutions
DB_USERNAME=eld
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too

MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@eldsolutions.com
MAIL_FROM_NAME="ELD Solutions Ltd"

# Used only by: docker compose exec app php artisan db:seed --force
ADMIN_NAME="ELD Admin"
ADMIN_EMAIL=admin@eldsolutions.com
ADMIN_PASSWORD=

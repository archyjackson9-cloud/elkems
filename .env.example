APP_NAME="ELD Solutions Ltd"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost/eldsolutions/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -------------------------------------------------------
# Database — MySQL (XAMPP default)
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eldsolutions
DB_USERNAME=root
DB_PASSWORD=

# -------------------------------------------------------
# Session & Cache (use file driver for simplicity on XAMPP)
# -------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file

# -------------------------------------------------------
# Mail — SMTP (update with your provider credentials)
# Common providers: Gmail, Mailgun, Brevo, Postmark, etc.
# -------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS="info@eldsolutionsgh.com"
MAIL_FROM_NAME="${APP_NAME}"

# For Mailgun:
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_SECRET=your-mailgun-api-key

# -------------------------------------------------------
# Admin seeder credentials (used by db:seed only)
# -------------------------------------------------------
ADMIN_NAME="ELD Admin"
ADMIN_EMAIL="admin@eldsolutions.com"
ADMIN_PASSWORD="Change_This_Password_Now!"

# -------------------------------------------------------
# Vite
# -------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
